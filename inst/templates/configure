#!/bin/sh
# Generated by rzig::use_rzig().
#
# Fail here, clearly, rather than three minutes into `zig build`. Order:
#   1. find zig   2. version check   3. target detection   4. substitute
set -e

ZIG_MIN="0.16.0"

# --- 1. find zig -------------------------------------------------------------
if [ -n "$ZIG" ] && [ -x "$ZIG" ]; then
  :
elif command -v zig >/dev/null 2>&1; then
  ZIG=$(command -v zig)
else
  for cand in "$HOME/.local/share/zig/zig" "$HOME/zig/zig" /usr/local/bin/zig /opt/zig/zig; do
    [ -x "$cand" ] && ZIG="$cand" && break
  done
fi

if [ -z "$ZIG" ]; then
  cat >&2 <<'MSG'
-------------------------------------------------------------------
 This package is written in Zig and needs the Zig compiler to build.

   Download:  https://ziglang.org/download/
   Then either put `zig` on your PATH, or set ZIG=/path/to/zig
   and reinstall.
-------------------------------------------------------------------
MSG
  exit 1
fi

# --- 2. version check --------------------------------------------------------
ZIG_VER=$("$ZIG" version)
# Naive but adequate: compare sorted -V output.
LOWEST=$(printf '%s\n%s\n' "$ZIG_MIN" "$ZIG_VER" | sort -V | head -n1)
if [ "$LOWEST" != "$ZIG_MIN" ]; then
  echo "Zig $ZIG_VER found, but $ZIG_MIN or newer is required." >&2
  echo "Download: https://ziglang.org/download/" >&2
  exit 1
fi
echo "using zig $ZIG_VER at $ZIG"

# --- 3. target from R's configuration, not the build host --------------------
R_BIN="${R_HOME}/bin/R"
[ -x "$R_BIN" ] || R_BIN=R
R_INCLUDE_DIR=$("$R_BIN" CMD config --cppflags | sed -e 's/^-I//' -e 's/ .*$//')

# --- 4. substitute -----------------------------------------------------------
sed -e "s|@ZIG@|$ZIG|g" \
    -e "s|@R_INCLUDE_DIR@|$R_INCLUDE_DIR|g" \
    src/Makevars.in > src/Makevars

exit 0
