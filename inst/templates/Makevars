# Generated by rzig::use_rzig().
#
# Zig builds a static archive; R's own $(SHLIB) rule links it. Do NOT make Zig
# emit the shared object directly - R's link line carries platform knowledge
# (-lR on Windows, macOS dynamic lookup, OpenMP flags) that is tedious and
# version-dependent to reproduce.

ZIG_DIR  = rzig
STATLIB  = $(ZIG_DIR)/zig-out/lib/libzigpkg.a
PKG_LIBS = $(STATLIB)

# ReleaseSafe, not ReleaseFast. A bounds check is cheaper than a
# user losing an eight-hour session.
ZIG_RELEASE ?= safe

all: $(SHLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	cd $(ZIG_DIR) && \
	"$(ZIG)" build \
	  --release=$(ZIG_RELEASE) \
	  -Dpkg=$(R_PACKAGE_NAME) \
	  -Dr-include="$(R_INCLUDE_DIR)" \
	  --cache-dir "$(CURDIR)/$(ZIG_DIR)/.zig-cache" \
	  --global-cache-dir "$(CURDIR)/$(ZIG_DIR)/.zig-global-cache"

# CRAN requires a clean target when the build produces artefacts outside
# $(OBJECTS), and forbids writing outside the build tree - hence the redirected
# cache directories above.
clean:
	rm -rf $(SHLIB) $(OBJECTS) \
	       $(ZIG_DIR)/zig-out $(ZIG_DIR)/.zig-cache $(ZIG_DIR)/.zig-global-cache

.PHONY: all clean
