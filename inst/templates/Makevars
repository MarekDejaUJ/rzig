# Generated by rzig::use_rzig().

ZIG = @ZIG@
ZIG_TARGET_ARG = @ZIG_TARGET_ARG@
R_INCLUDE_DIR = @R_INCLUDE_DIR@
ZIG_DIR = rzig
STATLIB = @STATLIB@
OBJECTS = entry.o
PKG_LIBS = $(STATLIB)

all: $(SHLIB)

$(SHLIB): $(STATLIB)

$(STATLIB): $(ZIG_DIR)/build.zig $(ZIG_DIR)/build.zig.zon \
            $(ZIG_DIR)/src/main.zig
	cd $(ZIG_DIR) && \
	"$(ZIG)" build \
	  --release=safe \
	  $(ZIG_TARGET_ARG) \
	  -Dpkg=$(R_PACKAGE_NAME) \
	  -Dr-include="$(R_INCLUDE_DIR)" \
	  --cache-dir "$(CURDIR)/$(ZIG_DIR)/.zig-cache" \
	  --global-cache-dir "$(CURDIR)/$(ZIG_DIR)/.zig-global-cache"
	@if test "$$(uname -s)" = Darwin && \
	    test -f "$(ZIG_DIR)/tools/repack_macos_archive.sh"; then \
	  sh "$(ZIG_DIR)/tools/repack_macos_archive.sh" "$(STATLIB)"; \
	fi

clean:
	rm -rf $(SHLIB) $(OBJECTS) \
	       $(ZIG_DIR)/zig-out $(ZIG_DIR)/.zig-cache \
	       $(ZIG_DIR)/.zig-global-cache

.PHONY: all clean
