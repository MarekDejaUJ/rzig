\name{named_summary}
\alias{named_summary}
\title{Summarize a Numeric Vector as a Named List}
\usage{
named_summary(x)
}
\arguments{
\item{x}{A numeric vector.}
}
\value{
A list with \code{values} and \code{count} elements.
}
\description{
Returns a numeric vector and its length through the RZig named-list builder.
}
