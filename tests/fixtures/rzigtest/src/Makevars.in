ZIG = @ZIG@
ZIG_TARGET_ARG = @ZIG_TARGET_ARG@
ZIG_DIR = rzig
STATLIB = @STATLIB@
OBJECTS = entry.o abi_check.o
PKG_LIBS = $(STATLIB)

all: $(SHLIB)

$(SHLIB): $(STATLIB)

entry.o: entry.c
	$(CC) $(ALL_CPPFLAGS) $(CPICFLAGS) -O2 -Wall -pedantic \
	  -c entry.c -o entry.o

abi_check.o: abi_check.c
	$(CC) $(ALL_CPPFLAGS) $(CPICFLAGS) -O2 -Wall -pedantic \
	  -c abi_check.c -o abi_check.o

$(STATLIB): $(ZIG_DIR)/build.zig $(ZIG_DIR)/build.zig.zon \
            $(ZIG_DIR)/src/main.zig
	cd $(ZIG_DIR) && \
	"$(ZIG)" build \
	  --release=safe \
	  $(ZIG_TARGET_ARG) \
	  --cache-dir "$(CURDIR)/$(ZIG_DIR)/.zig-cache" \
	  --global-cache-dir "$(CURDIR)/$(ZIG_DIR)/.zig-global-cache"

clean:
	rm -rf $(SHLIB) $(OBJECTS) \
	       $(ZIG_DIR)/zig-out $(ZIG_DIR)/.zig-cache \
	       $(ZIG_DIR)/.zig-global-cache

.PHONY: all clean
