ZIG = @ZIG@
ZIG_TARGET_ARG = @ZIG_TARGET_ARG@
ZIG_DIR = rzig
STATLIB = @STATLIB@
OBJECTS = entry.o abi_check.o
PKG_LIBS = $(STATLIB)

all: $(SHLIB)

$(SHLIB): $(STATLIB)

entry.o: entry.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) \
	  -c entry.c -o entry.o

abi_check.o: abi_check.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) \
	  -c abi_check.c -o abi_check.o

$(STATLIB): FORCE
	cd $(ZIG_DIR) && \
	ZIG_GLOBAL_CACHE_DIR="$${RZIG_ZIG_CACHE:-$(CURDIR)/$(ZIG_DIR)/.zig-global-cache}" \
	"$(ZIG)" build \
	  --release=safe -j2 \
	  $(ZIG_TARGET_ARG) \
	  --cache-dir "$(CURDIR)/$(ZIG_DIR)/.zig-cache"
	@if test "$$(uname -s)" = Darwin; then \
	  sh "$(ZIG_DIR)/tools/repack_macos_archive.sh" "$(STATLIB)"; \
	fi

# make cannot see the Zig sources under $(ZIG_DIR), so `zig build` runs on
# every installation; Zig's own cache keeps an unchanged build fast.
FORCE:

clean:
	rm -rf $(SHLIB) $(OBJECTS) \
	       $(ZIG_DIR)/zig-out $(ZIG_DIR)/.zig-cache \
	       $(ZIG_DIR)/.zig-global-cache

.PHONY: all clean FORCE
