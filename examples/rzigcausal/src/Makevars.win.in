# Generated by rzig::use_rzig().

ZIG = @ZIG@
ZIG_TARGET_ARG = @ZIG_TARGET_ARG@
R_INCLUDE_DIR = @R_INCLUDE_DIR@
ZIG_DIR = rzig
STATLIB = $(ZIG_DIR)/zig-out/lib/zigpkg.lib
OBJECTS = entry.o
# Zig's Windows thread runtime calls native NT entry points.
PKG_LIBS = $(STATLIB) -lntdll @RZIG_LAPACK_LIBS@

all: $(SHLIB)

$(SHLIB): $(STATLIB)

entry.o: entry.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) \
	  -c entry.c -o entry.o

# Zig keeps its global cache inside the package unless RZIG_ZIG_CACHE names a
# persistent directory (developer machines; checks leave it unset).
# RZIG_OPTIMIZE=Debug builds the Zig code without optimization and with the
# safety checks of the default ReleaseSafe; other modes are rejected.
$(STATLIB): FORCE
	case "$${RZIG_OPTIMIZE:-ReleaseSafe}" in \
	  ReleaseSafe) release=--release=safe ;; \
	  Debug) release= ;; \
	  *) echo "rzig: RZIG_OPTIMIZE must be ReleaseSafe or Debug; got $${RZIG_OPTIMIZE}" >&2; exit 1 ;; \
	esac; \
	cd $(ZIG_DIR) && \
	ZIG_GLOBAL_CACHE_DIR="$${RZIG_ZIG_CACHE:-$(CURDIR)/$(ZIG_DIR)/.zig-global-cache}" \
	"$(ZIG)" build \
	  $$release -j2 \
	  $(ZIG_TARGET_ARG) \
	  -Dpkg=$(R_PACKAGE_NAME) \
	  -Dr-include="$(R_INCLUDE_DIR)" \
	  --cache-dir "$(CURDIR)/$(ZIG_DIR)/.zig-cache"

# make cannot see the Zig sources under $(ZIG_DIR), so `zig build` runs on
# every installation; Zig's own cache keeps an unchanged build fast.
FORCE:

clean:
	rm -rf $(SHLIB) $(OBJECTS) \
	       $(ZIG_DIR)/zig-out $(ZIG_DIR)/.zig-cache \
	       $(ZIG_DIR)/.zig-global-cache

.PHONY: all clean FORCE
